#!/bin/sh
# Configuration live-build de protect.OS (base Debian 13 « trixie », amd64)
set -e

lb config noauto \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main contrib non-free non-free-firmware" \
	--debian-installer none \
	--binary-images iso-hybrid \
	--iso-application "protect.OS" \
	--iso-publisher "protect.OS" \
	--iso-volume "PROTECT_OS" \
	--image-name protect-os \
	--bootappend-live "boot=live components quiet splash loglevel=3 rd.udev.log_level=3 systemd.show_status=false vt.global_cursor_default=0 hostname=protectos username=protect locales=fr_FR.UTF-8 keyboard-layouts=fr timezone=Europe/Paris" \
	"${@}"
