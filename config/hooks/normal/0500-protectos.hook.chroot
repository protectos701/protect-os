#!/bin/sh
# Réglages propres à l'image d'essai, exécutés pendant la construction de l'ISO.
# Tout le reste (thème, identité, démarrage) est dans les paquets protectos-*.
set -e

echo "protect.OS : masquage du lanceur d'installation Debian (remplacé par « Installer protect.OS »)"
for f in /usr/share/applications/install-debian.desktop /usr/share/applications/calamares.desktop; do
	if [ -f "$f" ] && ! grep -q '^NoDisplay=true' "$f"; then
		echo "NoDisplay=true" >> "$f"
	fi
done

# L'installateur Debian pose aussi une icône « Install Debian » sur le bureau au démarrage : on la retire
for f in /etc/xdg/autostart/calamares-desktop-icon.desktop /etc/xdg/autostart/install-debian.desktop \
		/etc/skel/Desktop/install-debian.desktop /etc/skel/Desktop/calamares.desktop; do
	[ -e "$f" ] && rm -f "$f" && echo "  retiré : $f"
done
grep -rl "install-debian" /etc/xdg/autostart 2>/dev/null | while read -r f; do rm -f "$f"; echo "  retiré : $f"; done

echo "protect.OS : photo de profil (recherche d'avatars Debian)"
ls -l /var/lib/AccountsService/icons 2>/dev/null || true
find /etc/skel /usr/share/plasma/avatars /usr/share/pixmaps -maxdepth 2 \( -iname '*face*' -o -iname '*debian*' \) 2>/dev/null | head -20

echo "protect.OS : nom du système"
ls -l /etc/os-release /usr/lib/os-release || true
if [ ! -L /etc/os-release ] || [ "$(readlink -f /etc/os-release)" != "/usr/lib/os-release" ]; then
	ln -sf ../usr/lib/os-release /etc/os-release
	echo "  /etc/os-release relié à l'identité protect.OS"
fi
grep PRETTY_NAME /etc/os-release

echo "protect.OS : compatibilité Windows 32 bits (wine32:i386)"
# Dans Debian 13, Wine a besoin de sa partie 32 bits pour les programmes Windows 32 bits.
dpkg --add-architecture i386
apt-get update
apt-get install -y wine32:i386 || echo "protect.OS : AVERTISSEMENT, wine32:i386 n'a pas pu être installé"

echo "protect.OS : Flathub dans Discover"
if command -v flatpak >/dev/null 2>&1; then
	flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
		|| echo "protect.OS : AVERTISSEMENT, Flathub n'a pas pu être ajouté"
fi

echo "protect.OS : liste du bloqueur de publicités et de traqueurs"
if [ -x /usr/lib/protectos/protectos-bloqueur ]; then
	/usr/lib/protectos/protectos-bloqueur mettre-a-jour \
		|| echo "protect.OS : AVERTISSEMENT, la liste sera téléchargée au premier démarrage"
fi

echo "protect.OS : retrait des programmes qui affichent KDE ou Debian"
# Chaque programme n'est retiré que si rien d'autre n'en a besoin (simulation d'abord).
for p in plasma-welcome kdeconnect khelpcenter konqueror kwalletmanager xterm kuserfeedback-console \
		debian-reference-common debian-faq imagemagick-7.q16 imagemagick-6.q16 kwrite; do
	dpkg -s "$p" >/dev/null 2>&1 || continue
	retires=$(apt-get -s purge "$p" | awk '/^Purg /{print $2}' | tr '\n' ' ')
	if [ "$retires" = "$p " ]; then
		apt-get purge -y "$p" >/dev/null && echo "  retiré : $p"
	else
		echo "  gardé (caché) : $p — d'autres éléments en dépendent ($retires)"
	fi
done

echo "protect.OS : pointeur de souris bleu et or (d'après le pointeur Brise)"
SRC=/usr/share/icons/breeze_cursors
DST=/usr/share/icons/ProtectOS-curseurs
if [ -d "$SRC/cursors_scalable" ]; then
	rm -rf "$DST"; mkdir -p "$DST"
	cp -r "$SRC/cursors_scalable" "$DST/"
	ln -s ../breeze_cursors/cursors "$DST/cursors"   # applications X11 : pointeur Brise d'origine
	# Corps bleu nuit, contour doré
	find "$DST/cursors_scalable" -name '*.svg' -exec sed -i \
		-e 's/#232629/#0a1a52/gI' -e 's/#31363b/#0a1a52/gI' -e 's/#000000/#0a1a52/gI' \
		-e 's/#fcfcfc/#f3d27a/gI' -e 's/#ffffff/#f3d27a/gI' -e 's/#eff0f1/#f3d27a/gI' {} +
	printf '[Icon Theme]\nName=protect.OS\nComment=Pointeur bleu et or\nInherits=breeze_cursors\n' > "$DST/index.theme"
	echo "  $(find "$DST/cursors_scalable" -name '*.svg' | wc -l) pointeurs recolorés"
else
	echo "  pointeur Brise vectoriel absent : pointeur par défaut conservé"
fi

echo "protect.OS : identité appliquée à tous les logiciels installés"
/usr/lib/protectos/protectos-identite tout || true
/usr/lib/protectos/protectos-identite avatar || true
ls -l /etc/skel/.face /etc/skel/.face.icon || true

echo "protect.OS : réglages de l'image d'essai terminés"
