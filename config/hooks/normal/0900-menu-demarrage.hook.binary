#!/bin/sh
# Menu de démarrage de l'ISO : image et textes protect.OS (plus de casque Debian ni de « Live system »).
set -e
for f in $(find . -path ./chroot -prune -o \( -name '*.cfg' -o -name 'theme.txt' \) -print 2>/dev/null); do
	case "$f" in *boot/grub*|*isolinux*|*syslinux*) ;; *) continue ;; esac
	sed -i \
		-e 's/Live system (amd64 fail-safe mode)/protect.OS (mode sans échec)/g' \
		-e 's/Live system (amd64)/Essayer ou installer protect.OS/g' \
		-e 's/Live system/protect.OS/g' \
		-e 's/Debian GNU\/Linux/protect.OS/g' -e 's/GNU\/Linux//g' -e 's/Debian/protect.OS/g' \
		-e 's/Memory Diagnostic Test/Test de la mémoire/g' -e 's/Hardware Detection Tool (HDT)/Détection du matériel/g' \
		-e 's/UEFI Firmware Settings/Réglages du PC (UEFI)/g' -e 's/Utilities/Outils/g' \
		-e 's/Boot menu/protect.OS/g' -e 's/Advanced options/Options avancées/g' \
		-e 's/fail-safe mode/mode sans échec/g' \
		-e 's/GNU GRUB  version/protect.OS/g' \
		"$f"
	echo "Menu de démarrage : textes de $f"
done
# Démarrage direct, comme Windows : le menu est caché, protect.OS démarre au bout de 2 secondes.
# (Échap au démarrage pour afficher le menu : mode sans échec, test de la mémoire…)
for f in boot/grub/*.cfg; do
	[ -f "$f" ] || continue
	sed -i -E 's/^([[:space:]]*)set timeout=[0-9-]+/\1set timeout=2/' "$f"
	sed -i -E 's/^([[:space:]]*)set timeout_style=[a-z]+/\1set timeout_style=hidden/' "$f"
done
if [ -f boot/grub/grub.cfg ]; then
	grep -q "timeout_style" boot/grub/grub.cfg || sed -i '1i set timeout_style=hidden\nset timeout=2' boot/grub/grub.cfg
	echo "Menu de démarrage (UEFI) caché"
fi
for f in isolinux/isolinux.cfg isolinux/menu.cfg syslinux/syslinux.cfg; do
	[ -f "$f" ] || continue
	sed -i -E 's/^([[:space:]]*)timeout [0-9]+/\1timeout 20/I' "$f"
	grep -qi "^timeout" "$f" || echo "timeout 20" >> "$f"
	grep -qi "menu hidden" "$f" || echo "menu hidden" >> "$f"
	echo "Menu de démarrage (BIOS) caché : $f"
done

python3 - <<'PY'
import glob, os
from PIL import Image, ImageDraw, ImageFont, ImageOps

racine = next(d for d in (".", "..", "../..") if os.path.isdir(os.path.join(d, "packages")))
fond = os.path.join(racine, "packages/protectos-wallpapers/root/usr/share/wallpapers/ProtectOS/contents/images/1920x1080.png")
logo = os.path.join(racine, "packages/protectos-plymouth/root/usr/share/plymouth/themes/protectos/logo.png")
nom = "protect.OS"
try:
    import configparser
    c = configparser.ConfigParser(); c.read(os.path.join(racine, "ma-personnalisation.conf"), encoding="utf-8")
    nom = c.get("identite", "nom", fallback=nom) or nom
except Exception:
    pass

def police(taille):
    for f in ("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",):
        if os.path.exists(f):
            return ImageFont.truetype(f, taille)
    return ImageFont.load_default()

images = [f for f in glob.glob("**/splash*.png", recursive=True) if "/chroot/" not in f]
for f in images:
    w, h = Image.open(f).size
    img = ImageOps.fit(Image.open(fond).convert("RGB"), (w, h), Image.LANCZOS)
    voile = Image.new("RGB", (w, h), (4, 10, 32))
    img = Image.blend(img, voile, 0.6)  # assombrit pour que le menu reste lisible
    t = int(h * 0.22)
    lg = Image.open(logo).convert("RGBA")
    lg = lg.resize((int(lg.width * t / lg.height), t), Image.LANCZOS)
    x, y = int(w * 0.06), int(h * 0.06)
    img.paste(lg, (x, y), lg)
    d = ImageDraw.Draw(img)
    d.text((x + lg.width + int(w * 0.03), y + int(t * 0.18)), nom, font=police(int(h * 0.075)), fill="#e8c15a")
    d.text((x + lg.width + int(w * 0.03), y + int(t * 0.62)), "Session d'essai et installation",
           font=police(int(h * 0.035)), fill="#eef2fb")
    img.save(f)
    print(f"Menu de démarrage : {f} ({w}x{h}) remplacé")
if not images:
    print("Menu de démarrage : aucune image trouvée (rien à remplacer)")
PY
