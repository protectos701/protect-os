#!/bin/sh
set -e

# Active le pare-feu (connexions entrantes bloquées, sortantes autorisées) une seule fois :
# si l'utilisateur le désactive ensuite, protect.OS respecte son choix.
activer_pare_feu() {
	FLAG=/var/lib/protectos/pare-feu-initialise
	[ -f /etc/ufw/ufw.conf ] && command -v ufw >/dev/null 2>&1 || return 0
	[ -f "$FLAG" ] && return 0
	mkdir -p /var/lib/protectos
	ufw default deny incoming >/dev/null 2>&1 || true
	ufw default allow outgoing >/dev/null 2>&1 || true
	if [ -d /run/systemd/system ]; then
		# Système en marche : activation immédiate
		ufw --force enable >/dev/null 2>&1 || true
	else
		# Construction de l'ISO ou installation hors ligne : activé au prochain démarrage
		sed -i 's/^ENABLED=no/ENABLED=yes/' /etc/ufw/ufw.conf
		systemctl enable ufw.service >/dev/null 2>&1 || true
	fi
	touch "$FLAG"
}

case "$1" in
	configure)
		activer_pare_feu
		/usr/lib/protectos/protectos-identite tout || true
		if command -v deb-systemd-helper >/dev/null 2>&1; then
			deb-systemd-helper enable protectos-identite.service >/dev/null || true
		fi
		# Applique les réglages GRUB sur un système installé (pas pendant la construction de l'ISO)
		if command -v update-grub >/dev/null 2>&1 && [ -f /boot/grub/grub.cfg ]; then
			update-grub || true
		fi
		;;
	triggered)
		activer_pare_feu
		/usr/lib/protectos/protectos-identite applications || true
		/usr/lib/protectos/protectos-identite sessions || true
		;;
esac
exit 0
