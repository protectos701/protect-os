#!/bin/sh
set -e
# Rend son identité d'origine à Debian si le paquet est retiré.
case "$1" in
	remove|abort-install|disappear)
		for f in /usr/lib/os-release /etc/issue /etc/issue.net /usr/sbin/update-grub; do
			dpkg-divert --package protectos-base --remove --rename --divert "$f.debian" "$f"
		done
		;;
esac
exit 0
