#!/bin/sh
set -e
# Remplace l'identité Debian par celle de protect.OS, en gardant l'original de côté.
if [ "$1" = "install" ] || [ "$1" = "upgrade" ]; then
	for f in /usr/lib/os-release /usr/sbin/update-grub; do
		dpkg-divert --package protectos-base --add --rename --divert "$f.debian" "$f"
	done
fi
exit 0
