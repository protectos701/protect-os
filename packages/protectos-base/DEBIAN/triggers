# Réagir quand le pare-feu ufw est installé, pour l'activer une première fois
interest-noawait /etc/ufw/ufw.conf
# Réappliquer l'identité protect.OS quand un logiciel ajoute un raccourci ou une session
interest-noawait /usr/share/applications
interest-noawait /usr/share/wayland-sessions
interest-noawait /usr/share/xsessions
# Réécrire le texte de connexion si une mise à jour le remet
interest-noawait /etc/issue
# Réappliquer les noms quand une mise à jour remplace les traductions
interest-noawait /usr/share/locale
# Réappliquer les raccourcis clavier choisis quand ils changent
interest-noawait /etc/xdg/kglobalshortcutsrc
