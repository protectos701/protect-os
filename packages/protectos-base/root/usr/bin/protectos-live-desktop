#!/bin/sh
# En session d'essai uniquement : place l'icône « Installer protect.OS » sur le bureau.
grep -qw "boot=live" /proc/cmdline || exit 0

SRC=""
for f in /usr/share/applications/install-protectos.desktop \
	/usr/share/applications/install-debian.desktop \
	/usr/share/applications/calamares.desktop; do
	[ -f "$f" ] && SRC="$f" && break
done
[ -n "$SRC" ] || exit 0

# Crée d'abord les dossiers en français (Bureau, Documents…), sinon un dossier « Desktop » apparaîtrait en double
command -v xdg-user-dirs-update >/dev/null 2>&1 && xdg-user-dirs-update >/dev/null 2>&1
DESK=$(xdg-user-dir DESKTOP 2>/dev/null)
[ -n "$DESK" ] && [ "$DESK" != "$HOME" ] || DESK="$HOME/Bureau"
mkdir -p "$DESK"
DEST="$DESK/installer-protect-os.desktop"
[ -f "$DEST" ] && exit 0
cp "$SRC" "$DEST"
chmod +x "$DEST"
