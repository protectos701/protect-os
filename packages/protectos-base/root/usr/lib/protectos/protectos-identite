# Noms neutres pour les logiciels qui portent un nom KDE/Linux (en plus de ceux choisis dans
# /etc/protectos/noms-applications.conf, qui passent en priorité).
NOMS = {
    "org.kde.dolphin.desktop": "Explorateur de fichiers", "org.kde.konsole.desktop": "Terminal",
    "org.kde.spectacle.desktop": "Capture d'écran", "org.kde.plasma-systemmonitor.desktop": "Gestionnaire des tâches",
    "org.kde.okular.desktop": "Lecteur PDF", "org.kde.gwenview.desktop": "Photos", "org.kde.kate.desktop": "Bloc-notes",
    "org.kde.kcalc.desktop": "Calculatrice", "org.kde.discover.desktop": "Magasin d'applications",
    "systemsettings.desktop": "Paramètres", "org.kde.ark.desktop": "Archives",
    "org.kde.partitionmanager.desktop": "Gestionnaire de disques", "firefox-esr.desktop": "Navigateur Internet",
    "firefox.desktop": "Navigateur Internet", "vlc.desktop": "Lecteur multimédia",
    "org.kde.skanlite.desktop": "Numériseur", "timeshift-gtk.desktop": "Sauvegardes du système",
    "org.kde.plasma.firewall.desktop": "Pare-feu", "libreoffice-writer.desktop": "Traitement de texte",
