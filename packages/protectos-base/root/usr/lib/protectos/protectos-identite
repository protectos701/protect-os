#!/usr/bin/python3
"""Efface toute trace visible de Linux, Debian et KDE dans protect.OS.

Relancé automatiquement après chaque installation ou mise à jour de logiciel
(déclencheurs dpkg) et à chaque démarrage, pour que rien ne réapparaisse.

  protectos-identite             tout appliquer
  protectos-identite grub        nettoyer seulement le menu de démarrage
  protectos-identite uefi        renommer l'entrée de démarrage du PC (« debian » → « protect.OS »)
"""
import glob
import os
import re
import subprocess
import sys

NOM = "protect.OS"
SRC = os.environ.get("PROTECTOS_APPS", "/usr/share/applications")
LOCAL = os.environ.get("PROTECTOS_APPS_LOCAL", "/usr/local/share/applications")
MARQUE = "X-ProtectOS-Identite=true"

