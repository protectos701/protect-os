# Mots à faire disparaître des descriptions (Comment, GenericName, Keywords)
MOTS = re.compile(r"\b(KDE|Plasma|Debian|GNU/Linux|Linux|Wine|Konqueror|Dolphin|Konsole|Okular|Gwenview|Kate|"
                  r"Discover|Spectacle|Ark|KCalc)\b ?", re.I)

SESSIONS = {"plasma.desktop": NOM, "plasmawayland.desktop": NOM, "plasmax11.desktop": f"{NOM} (compatibilité)"}


def lire_noms_choisis():
    noms = {}
    try:
        for ligne in open("/etc/protectos/noms-applications.conf", encoding="utf-8"):
            ligne = ligne.strip()
            if ligne and not ligne.startswith("#") and "=" in ligne:
                k, v = ligne.split("=", 1)
                if v.strip():
                    noms[k.strip()] = v.strip()
    except OSError:
        pass
    return noms


def reecrire(src, nom=None, cacher=False):
    """Copie le raccourci dans /usr/local (prioritaire) avec un nom neutre ou caché."""
    out, section = [], None
    for ligne in open(src, encoding="utf-8", errors="replace").read().splitlines():
        if ligne.startswith("["):
            section = ligne
            out.append(ligne)
            if ligne == "[Desktop Entry]":
                if nom:
                    out.append(f"Name={nom}")
                if cacher:
                    out.append("NoDisplay=true")
                out.append(MARQUE)
            continue
        if section == "[Desktop Entry]":
            cle = ligne.split("=", 1)[0].split("[", 1)[0]
            if nom and cle in ("Name", "X-GNOME-FullName"):
                continue
            if cacher and cle == "NoDisplay":
                continue
            if cle in ("GenericName", "Comment") and MOTS.search(ligne.split("=", 1)[-1]):
                continue  # une description qui cite KDE/Linux disparaît (le nom suffit)
            if cle in ("Keywords", "Name") and "=" in ligne:
                k, v = ligne.split("=", 1)
                v = re.sub(r" {2,}", " ", MOTS.sub("", v)).strip(" ,;-")
                if not v:
                    continue
                ligne = f"{k}={v}"
        elif section and section.startswith("[Desktop Action") and nom:
            ligne = MOTS.sub("", ligne) if ligne.startswith("Name") else ligne
        out.append(ligne)
    dst = os.path.join(LOCAL, os.path.basename(src))
    os.makedirs(LOCAL, exist_ok=True)
    with open(dst, "w", encoding="utf-8") as f:
        f.write("\n".join(out) + "\n")


def applications():
    noms = {**NOMS, **lire_noms_choisis()}
    faits = set()
    for src in sorted(glob.glob(os.path.join(SRC, "*.desktop"))):
        base = os.path.basename(src)
        dst = os.path.join(LOCAL, base)
        if os.path.exists(dst) and MARQUE not in open(dst, encoding="utf-8", errors="replace").read():
            continue  # raccourci personnalisé par l'administrateur : on n'y touche pas
        if base in CACHER:
            reecrire(src, cacher=True)
        elif base in noms:
            reecrire(src, nom=noms[base])
        elif MOTS.search(open(src, encoding="utf-8", errors="replace").read()):
            reecrire(src)
        else:
            continue
        faits.add(base)
    # Retire nos copies dont l'original a été désinstallé
    for dst in glob.glob(os.path.join(LOCAL, "*.desktop")):
        base = os.path.basename(dst)
        if base not in faits and not os.path.exists(os.path.join(SRC, base)):
            if MARQUE in open(dst, encoding="utf-8", errors="replace").read():
                os.remove(dst)
    if os.path.exists("/usr/bin/update-desktop-database"):
        subprocess.run(["update-desktop-database", "-q", LOCAL], capture_output=True)


def sessions():
    """Le choix de session sur l'écran de connexion affiche « protect.OS » au lieu de « Plasma »."""
    for d in ("/usr/share/wayland-sessions", "/usr/share/xsessions"):
        for f in glob.glob(os.path.join(d, "*.desktop")):
            nom = SESSIONS.get(os.path.basename(f))
            if not nom:
                continue
            lignes = open(f, encoding="utf-8").read().splitlines()
            neuf = []
            for ligne in lignes:
                cle = ligne.split("=", 1)[0].split("[", 1)[0]
                if cle in ("Name", "Comment"):
                    continue
                neuf.append(ligne)
                if ligne == "[Desktop Entry]":
                    neuf += [f"Name={nom}", f"Comment={NOM}"]
            if neuf != lignes:
                with open(f, "w", encoding="utf-8") as fh:
                    fh.write("\n".join(neuf) + "\n")


def grub(cfg="/boot/grub/grub.cfg"):
    """Menu de démarrage : « protect.OS » partout, sans « GNU/Linux », « Linux 6.x » ni « Loading Linux… »."""
    if not os.path.exists(cfg):
        return
    texte = open(cfg, encoding="utf-8", errors="replace").read()
    neuf = []
    for ligne in texte.splitlines():
        s = ligne.strip()
        if s.startswith("echo") and re.search(r"Loading (Linux|initial ramdisk)|Chargement de Linux|"
                                              r"Chargement du disque", s):
            continue
        if s.startswith(("menuentry ", "submenu ")):
            ligne = (ligne.replace(" GNU/Linux", "").replace("Debian", NOM)
                     .replace("Advanced options for", "Options avancées de")
                     .replace("Options avancées pour", "Options avancées de")
                     .replace("(recovery mode)", "(mode de secours)").replace("(mode de dépannage)", "(mode de secours)"))
            ligne = re.sub(r", (with|avec) Linux ([^'\"]+)", r", version \2", ligne)
            ligne = ligne.replace("UEFI Firmware Settings", "Réglages du PC (UEFI)")
        neuf.append(ligne)
    sortie = "\n".join(neuf) + "\n"
    if sortie != texte:
        tmp = cfg + ".protectos"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(sortie)
        os.chmod(tmp, os.stat(cfg).st_mode & 0o777)
        os.replace(tmp, cfg)


def uefi():
    """Le menu de démarrage du PC (touche F12/F8…) affiche « protect.OS » au lieu de « debian »."""
    if not os.path.isdir("/sys/firmware/efi") or not os.path.exists("/usr/bin/efibootmgr"):
        return
    r = subprocess.run(["efibootmgr"], capture_output=True, text=True)
    if r.returncode:
        return
    entrees = [(n, l, c) for n, l, c in re.findall(r"^Boot([0-9A-F]{4})\*? ([^\t\n]+)\t?(.*)$", r.stdout, re.M)]
    debian = [(n, chemin) for n, label, chemin in entrees if label.strip().lower() == "debian"]
    deja = any(label.strip() == NOM for _n, label, _c in entrees)
    if not debian:
        return
    if not deja:
        loader = "\\EFI\\debian\\shimx64.efi" if os.path.exists("/boot/efi/EFI/debian/shimx64.efi") \
            else "\\EFI\\debian\\grubx64.efi"
        src = subprocess.run(["findmnt", "-no", "SOURCE", "/boot/efi"], capture_output=True, text=True).stdout.strip()
        if not src.startswith("/dev/"):
            return
        part = os.path.basename(os.path.realpath(src))
        try:
            numero = open(f"/sys/class/block/{part}/partition").read().strip()
        except OSError:
            return
        disque = subprocess.run(["lsblk", "-no", "PKNAME", src], capture_output=True, text=True).stdout.strip()
        if not disque:
            return
        c = subprocess.run(["efibootmgr", "-q", "-c", "-d", f"/dev/{disque}", "-p", numero, "-L", NOM,
                            "-l", loader], capture_output=True, text=True)
        if c.returncode:
            return  # on garde l'entrée d'origine : le PC doit toujours pouvoir démarrer
    for n, _c in debian:
        subprocess.run(["efibootmgr", "-q", "-b", n, "-B"], capture_output=True)


def nom_systeme():
    """/etc/os-release doit toujours désigner l'identité protect.OS."""
    try:
        if os.path.exists("/usr/lib/os-release") and "protect" in open("/usr/lib/os-release").read() and \
                os.path.realpath("/etc/os-release") != "/usr/lib/os-release":
            tmp = "/etc/.os-release.protectos"
            if os.path.lexists(tmp):
                os.remove(tmp)
            os.symlink("../usr/lib/os-release", tmp)
            os.replace(tmp, "/etc/os-release")
    except OSError:
        pass


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "tout"
    if cmd == "tout":
        nom_systeme()
    if cmd in ("tout", "applications"):
        applications()
    if cmd in ("tout", "sessions"):
        sessions()
    if cmd in ("tout", "grub"):
        grub()
    if cmd == "uefi":
        uefi()
    return 0


if __name__ == "__main__":
    sys.exit(main())
