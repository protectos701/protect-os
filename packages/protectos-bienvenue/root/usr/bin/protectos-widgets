#!/usr/bin/python3
"""Ouvre ou ferme le panneau des widgets (Windows+W)."""
import configparser
import os
import re
import subprocess
import sys

FICHIER = os.path.expanduser("~/.config/plasma-org.kde.plasma.desktop-appletsrc")


def identifiant():
    cp = configparser.RawConfigParser(strict=False, interpolation=None)
    try:
        cp.read(FICHIER, encoding="utf-8")
    except (configparser.Error, UnicodeDecodeError):
        return None
    for section in cp.sections():
        m = re.fullmatch(r"Containments\]\[\d+\]\[Applets\]\[(\d+)", section.strip("[]"))
        if m and cp.get(section, "plugin", fallback="") == "org.protectos.widgets":
            return m.group(1)
    return None


def main():
    n = identifiant()
    if not n:
        return 1
    subprocess.run(["gdbus", "call", "--session", "--dest", "org.kde.kglobalaccel", "--object-path",
                    "/component/plasmashell", "--method", "org.kde.kglobalaccel.Component.invokeShortcut",
                    f"activate widget {n}"], capture_output=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
