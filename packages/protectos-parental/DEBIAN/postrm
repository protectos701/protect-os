#!/bin/sh
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	command -v nft >/dev/null 2>&1 && nft delete table inet protectos_parental >/dev/null 2>&1 || true
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper purge protectos-parental.timer protectos-parental-filtre.service >/dev/null || true
	fi
fi
if [ "$1" = "purge" ]; then
	rm -rf /var/lib/protectos/parental /etc/protectos/parental.json
fi
exit 0
