# Écran de démarrage de protect.OS : logo, nom en or et barre de progression dorée.

Window.SetBackgroundTopColor(0.086, 0.188, 0.478);
Window.SetBackgroundBottomColor(0.024, 0.059, 0.180);

W = Window.GetWidth();
H = Window.GetHeight();

# Logo
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(W / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(H / 2 - logo.image.GetHeight() / 2 - 60);

# Nom
title.image = Image.Text("protect.OS", 0.91, 0.76, 0.35, 1, "Sans Bold 22");
title.sprite = Sprite(title.image);
title.sprite.SetX(W / 2 - title.image.GetWidth() / 2);
title.sprite.SetY(H / 2 + logo.image.GetHeight() / 2 - 30);

# Barre de progression
bar_w = 240;
bar_y = H / 2 + logo.image.GetHeight() / 2 + 30;
track.image = Image("track.png").Scale(bar_w, 4);
track.sprite = Sprite(track.image);
track.sprite.SetX(W / 2 - bar_w / 2);
track.sprite.SetY(bar_y);

fill.source = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetX(W / 2 - bar_w / 2);
fill.sprite.SetY(bar_y);
fill.sprite.SetZ(2);

fun progress_callback(duration, progress) {
    w = Math.Int(bar_w * progress);
    if (w < 1) w = 1;
    fill.sprite.SetImage(fill.source.Scale(w, 4));
}
Plymouth.SetBootProgressFunction(progress_callback);

# Mot de passe (disque chiffré) et questions
prompt.sprite = Sprite();
prompt.sprite.SetZ(3);
entry.sprite = Sprite();
entry.sprite.SetZ(3);

fun display_password_callback(text, bullets) {
    prompt.image = Image.Text(text, 0.93, 0.95, 0.98, 1, "Sans 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(W / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(bar_y + 30);
    dots = "";
    for (i = 0; i < bullets; i++) dots = dots + "•";
    if (dots == "") dots = " ";
    entry.image = Image.Text(dots, 0.91, 0.76, 0.35, 1, "Sans 16");
    entry.sprite.SetImage(entry.image);
    entry.sprite.SetX(W / 2 - entry.image.GetWidth() / 2);
    entry.sprite.SetY(bar_y + 56);
    prompt.sprite.SetOpacity(1);
    entry.sprite.SetOpacity(1);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_question_callback(text, answer) {
    display_password_callback(text + " " + answer, 0);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_normal_callback() {
    prompt.sprite.SetOpacity(0);
    entry.sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# Messages système (une ligne en bas de l'écran)
msg.sprite = Sprite();
msg.sprite.SetZ(3);
fun message_callback(text) {
    msg.image = Image.Text(text, 0.66, 0.70, 0.82, 1, "Sans 10");
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetX(W / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(H - 50);
}
Plymouth.SetMessageFunction(message_callback);

# Arrêt, redémarrage, mises à jour : message et petits points dorés qui tournent (comme sous Windows)
mode = Plymouth.GetMode();
etat_texte = "";
if (mode == "shutdown") etat_texte = "Arrêt en cours…";
if (mode == "reboot") etat_texte = "Redémarrage en cours…";
if (mode == "updates" || mode == "system-upgrade") etat_texte = "Installation des mises à jour… N'éteignez pas l'ordinateur.";

if (etat_texte != "") {
    track.sprite.SetOpacity(0);
    fill.sprite.SetOpacity(0);
    etat.image = Image.Text(etat_texte, 0.93, 0.95, 0.98, 1, "Sans 13");
    etat.sprite = Sprite(etat.image);
    etat.sprite.SetX(W / 2 - etat.image.GetWidth() / 2);
    etat.sprite.SetY(bar_y + 46);
    point.image = Image("fill.png").Scale(6, 6);
    for (i = 0; i < 6; i++) {
        points[i] = Sprite(point.image);
        points[i].SetZ(4);
    }
    global.tour = 0;
    fun tourner() {
        global.tour = global.tour + 1;
        for (i = 0; i < 6; i++) {
            a = (global.tour * 0.09) - i * 0.32;
            points[i].SetX(W / 2 + Math.Cos(a) * 14 - 3);
            points[i].SetY(bar_y + 8 + Math.Sin(a) * 14 - 3);
            points[i].SetOpacity(1 - i * 0.14);
        }
    }
    Plymouth.SetRefreshFunction(tourner);
}
