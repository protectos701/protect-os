#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
	# Mise à jour hebdomadaire du bloqueur de publicités
	if command -v deb-systemd-helper >/dev/null 2>&1; then
		deb-systemd-helper enable protectos-bloqueur.timer >/dev/null || true
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		systemctl start protectos-bloqueur.timer >/dev/null 2>&1 || true
	fi
fi
# Sauvegarde des documents : minuterie activée pour tous les comptes (elle ne fait rien tant
# qu'aucun disque de sauvegarde n'a été choisi)
if [ "$1" = "configure" ] && command -v systemctl >/dev/null 2>&1; then
	systemctl --global enable protectos-sauvegarde.timer >/dev/null 2>&1 || true
fi
exit 0
