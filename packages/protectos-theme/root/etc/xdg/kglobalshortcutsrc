# Créé par tools/personnaliser.py à partir de ma-personnalisation.conf — ne pas modifier.
# Raccourcis clavier par défaut de protect.OS (modifiables dans Paramètres → Raccourcis).

[services][org.kde.dolphin.desktop]
_launch=Meta+E

[services][protectos-gestionnaire-taches.desktop]
_launch=Ctrl+Shift+Esc

[services][systemsettings.desktop]
_launch=Meta+I

[services][org.kde.konsole.desktop]
_launch=Ctrl+Alt+T

[services][org.kde.spectacle.desktop]
RectangularRegionScreenShot=Meta+Shift+S

[services][org.kde.krunner.desktop]
_launch=Alt+Space	Meta+R

[services][protectos-protection.desktop]
_launch=Meta+Shift+P

[services][org.kde.plasma.emojier.desktop]
_launch=Meta+.

[kwin]
Window Maximize=Meta+Up	Meta+PgUp,Meta+PgUp,Agrandir la fenêtre
Window Minimize=Meta+Down	Meta+PgDown,Meta+PgDown,Réduire la fenêtre
Window Quick Tile Top=none,Meta+Up,Mosaïque en haut
Window Quick Tile Bottom=none,Meta+Down,Mosaïque en bas
Overview=Meta+Tab	Meta+W,Meta+W,Vue d'ensemble

[plasmashell]
next activity=none,Meta+Tab,Activité suivante
previous activity=none,Meta+Shift+Tab,Activité précédente
show-on-mouse-pos=Meta+V,Meta+V,Afficher le presse-papiers à la position de la souris
